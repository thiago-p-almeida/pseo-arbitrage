---
export const prerender = false; // Executa em modo SSR no Cloudflare Edge

import Layout from '../layouts/Layout.astro';
import { getProductBySlug, getProductCompatibilities, getFallbackProducts } from '../lib/d1';
import { withEdgeCache } from '../lib/cache';

const { slug } = Astro.params;

// Extração ultra-robusta do binding D1 no Cloudflare Pages/Workers
const locals = Astro.locals as any;
const d1 = locals?.runtime?.env?.DB || locals?.env?.DB || locals?.DB;

let product: any = null;
let compatibilities: any[] = [];
let fallbacks: any[] = [];
let offers: any[] = [];
let specs: any = {};
let jsonLd: any = null;

// Processa apenas se o slug existir e não for a própria palavra '404'
if (slug && slug !== '404') {
  const response = await withEdgeCache(
    Astro.request,
    async () => {
      if (!d1) {
        console.error('Erro: Binding DB não encontrado em Astro.locals');
        return new Response('Database Binding Error', { status: 500 });
      }

      const prod = await getProductBySlug(d1, slug);

      if (!prod) {
        return new Response('Não Encontrado', { status: 404 });
      }

      const comps = await getProductCompatibilities(d1, prod.id);
      const falls = await getFallbackProducts(d1, prod.category, 4);

      const offs = prod.offers_json ? JSON.parse(prod.offers_json) : [];
      const sps = prod.specs_json ? JSON.parse(prod.specs_json) : {};

      const schema = {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": prod.title,
        "mpn": prod.oem_code || prod.ean_upc || prod.id,
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": "BRL",
          "lowPrice": prod.lowest_price || "0.00",
          "offerCount": offs.length
        },
        "isAccessoryOrSparePartFor": comps.map((c: any) => ({
          "@type": "Vehicle",
          "brand": c.make,
          "model": c.model,
          "vehicleModelDate": c.year_start ? String(c.year_start) : undefined
        }))
      };

      return new Response(
        JSON.stringify({ product: prod, compatibilities: comps, fallbacks: falls, offers: offs, specs: sps, jsonLd: schema }),
        {
          status: 200,
          headers: { 'Content-Type': 'application/json' }
        }
      );
    },
    locals?.runtime?.ctx
  );

  if (response.status === 200) {
    const data = await response.json();
    product = data.product;
    compatibilities = data.compatibilities;
    fallbacks = data.fallbacks;
    offers = data.offers;
    specs = data.specs;
    jsonLd = data.jsonLd;
  } else {
    Astro.response.status = response.status;
  }
} else {
  Astro.response.status = 404;
}
---

{product ? (
  <Layout 
    title={`${product.title} - Menor Preço e Compatibilidade`} 
    description={`Confira ofertas para ${product.title}. Código OEM/EAN: ${product.oem_code || product.ean_upc || 'N/A'}. Compare preços agora.`}
    jsonLdSchema={jsonLd}
  >
    <article class="space-y-8">
      <header class="border-b border-slate-200 pb-4">
        <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider">{product.category}</span>
        <h1 class="text-3xl font-extrabold text-slate-900 mt-1">{product.title}</h1>
        <p class="text-sm text-slate-500 mt-1">OEM / EAN: <code class="bg-slate-100 px-2 py-0.5 rounded text-slate-800">{product.oem_code || product.ean_upc || 'Universal'}</code></p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Ofertas e CTAs (Monetização Afiliados) -->
        <section class="md:col-span-2 space-y-4">
          <h2 class="text-xl font-bold text-slate-900">Ofertas Disponíveis</h2>
          {offers.length > 0 ? (
            <div class="space-y-3">
              {offers.map((offer: any) => (
                <div class="p-4 bg-white rounded-lg border border-slate-200 shadow-sm flex items-center justify-between">
                  <div>
                    <span class="font-semibold text-slate-800 block">{offer.store || 'Loja Parceira'}</span>
                    <span class="text-2xl font-bold text-emerald-600">R$ {Number(offer.price).toFixed(2)}</span>
                  </div>
                  <a 
                    href={offer.url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-2.5 rounded-lg transition-colors shadow-sm text-sm"
                  >
                    Ver Oferta →
                  </a>
                </div>
              ))}
            </div>
          ) : (
            <div class="p-4 bg-amber-50 border border-amber-200 rounded-lg text-amber-800 text-sm">
              <p>Ofertas diretas em atualização para esta especificação. Veja modelos compatíveis ou similares abaixo.</p>
            </div>
          )}
        </section>

        <!-- Matriz de Compatibilidade Automotiva -->
        <aside class="space-y-4">
          <h3 class="text-lg font-bold text-slate-900">Veículos Compatíveis</h3>
          {compatibilities.length > 0 ? (
            <ul class="divide-y divide-slate-100 bg-white rounded-lg border border-slate-200 text-sm">
              {compatibilities.map((comp: any) => (
                <li class="p-3 text-slate-700 flex justify-between">
                  <span class="font-medium capitalize">{comp.make} {comp.model}</span>
                  <span class="text-slate-500">{comp.year_start} - {comp.year_end || 'Atual'}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-slate-500">Peça com especificação universal / Eletrônico.</p>
          )}
        </aside>
      </div>
    </article>
  </Layout>
) : (
  <Layout title="Produto Não Encontrado" description="O item solicitado não está disponível em nosso catálogo.">
    <div class="text-center py-16 space-y-4">
      <h1 class="text-4xl font-extrabold text-slate-800">404 - Produto Não Encontrado</h1>
      <p class="text-slate-600 max-w-md mx-auto">O item solicitado não foi localizado em nosso banco de dados no Edge.</p>
      <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-2.5 rounded-lg transition-colors">
        Voltar para a Página Inicial
      </a>
    </div>
  </Layout>
)}