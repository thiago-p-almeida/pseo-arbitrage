---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
// Ordenação por pubDate decrescente (mais recente primeiro)
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Portal de Pesquisa Técnica | Análises e Guias"
  description="Guias independentes, análises automotivas e tecnologia de ponta"
>
  <div class="space-y-16">

    <!-- Hero Section -->
    <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-800 via-slate-900 to-slate-950 p-10 md:p-16 text-center">
      <div class="relative z-10">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-4">
          Portal de Pesquisa Técnica
        </h1>
        <p class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Guias independentes, análises automotivas e tecnologia de ponta
        </p>
      </div>
      <!-- Decoração de fundo sutíl -->
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_50%_50%,rgba(59,130,246,0.3),transparent_70%)] pointer-events-none" aria-hidden="true" />
    </section>

    <!-- Grid de Artigos em Destaque -->
    <section class="space-y-8">
      <div class="flex items-center justify-between border-b border-slate-200 pb-4">
        <h2 class="text-2xl font-bold text-slate-900">Artigos em Destaque</h2>
        <span class="text-sm text-slate-500">{posts.length} artigo{posts.length !== 1 ? 's' : ''}</span>
      </div>

      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="group bg-white rounded-xl border border-slate-200 p-6 shadow-sm hover:shadow-lg hover:border-blue-200 transition-all duration-200 flex flex-col"
            >
              <div class="flex-1 space-y-3">
                <span class="inline-block bg-blue-50 text-blue-700 text-xs font-semibold px-3 py-1 rounded-full">
                  {post.data.category}
                </span>
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-700 transition-colors leading-snug">
                  {post.data.title}
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
              </div>
              <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                <span>{post.data.author}</span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {new Date(post.data.pubDate).toLocaleDateString('pt-BR', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                  })}
                </time>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-xl border border-slate-200 p-10 text-center">
          <p class="text-slate-500 text-lg">Nenhum artigo publicado ainda. Volte em breve!</p>
        </div>
      )}
    </section>

    <!-- Seção E-E-A-T (Sobre a Redação) -->
    <section class="bg-slate-50 border border-slate-200 rounded-2xl p-8 md:p-10 text-center max-w-4xl mx-auto">
      <h2 class="text-xl font-bold text-slate-900 mb-4">Sobre a Redação</h2>
      <p class="text-slate-600 leading-relaxed max-w-3xl mx-auto">
        O <strong class="text-slate-800">Portal de Pesquisa Técnica</strong> é um veículo editorial independente dedicado à
        produção de conteúdo técnico automotivo e de tecnologia. Nossa equipe é composta por profissionais
        com experiência em engenharia, mecânica e análise de sistemas. Priorizamos a <strong>isenção</strong>,
        a <strong>profundidade técnica</strong> e a <strong>independência editorial</strong> em cada artigo
        publicado — sem vínculos com fabricantes ou marcas específicas.
      </p>
    </section>

  </div>
</Layout>